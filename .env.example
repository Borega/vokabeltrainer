# Öffentliche Adresse der App (ohne / am Ende)
BASE_URL=https://vokabeln.meine-schule.de

# --- OpenID Connect ---
# Bei IServ: Adresse des IServ-Servers. Die App liest /.well-known/openid-configuration.
OIDC_ISSUER=https://meine-schule.de
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Bei IServ ohne Gruppen/Rollen-Zugriff reicht "openid profile" – dann gibt es aber keine
# Gruppen-Zuweisung. Für andere Anbieter ggf. anpassen.
OIDC_SCOPES=openid profile iserv:groups iserv:roles
# Name der Claims mit Gruppen und Rollen (IServ: iserv:groups / iserv:roles;
# fehlt der Claim, werden automatisch auch "groups"/"roles" probiert)
OIDC_GROUPS_CLAIM=iserv:groups
OIDC_ROLES_CLAIM=iserv:roles
# Beim Einrichten auf true setzen: Die empfangenen Claims erscheinen im Log.
OIDC_LOG_CLAIMS=false

# --- Wer ist Lehrkraft? (Komma-getrennt, Groß-/Kleinschreibung egal) ---
# Treffer bei Rollen ODER Gruppen (ID oder Anzeigename) genügt.
TEACHER_ROLES=ROLE_TEACHER,teacher,lehrer
TEACHER_GROUPS=lehrer
# Gruppen, die bei der Listen-Zuweisung nicht angeboten werden
HIDDEN_GROUPS=alle,lehrer,schueler,schüler

# --- Sonstiges ---
APP_NAME=Vokabeltrainer
LOGIN_LABEL=Mit IServ anmelden
# Wie lange eine Anmeldung gültig bleibt (Tage)
SESSION_DAYS=7
# Konten ohne Anmeldung seit so vielen Tagen werden samt Lernstand gelöscht (0 = nie)
RETENTION_DAYS=400
# Hinter einem Reverse-Proxy (in Produktion Standard: true)
TRUST_PROXY=true
# Darf die App in einem iframe angezeigt werden? z. B. "'self' https://meine-schule.de" (mit doppelten Anführungszeichen)
FRAME_ANCESTORS="'self'"

# Nur für die lokale Entwicklung (wird mit NODE_ENV=production ignoriert):
# DEV_LOGIN=true
