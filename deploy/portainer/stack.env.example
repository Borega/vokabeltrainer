# Ausfüllen und in Portainer unter "Environment variables" → "Load variables from .env file" laden.
# Diese Datei mit echten Werten NICHT ins Git-Repo einchecken.

# Pflicht
BASE_URL=https://vokabeln.meine-schule.de
# Adresse des IServ (wie im Browser, ohne /iserv)
OIDC_ISSUER=https://meine-schule.de
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Beim ersten Einrichten auf true: Gruppen/Rollen erscheinen in den Container-Logs.
OIDC_LOG_CLAIMS=false

# Optional (Standardwerte stehen in docker-compose.yml)
# Interne IP des Docker-Hosts, falls nginx auf einem anderen Server läuft (Standard: 127.0.0.1)
# BIND_IP=192.0.2.10
# HOST_PORT=3000
# TEACHER_ROLES=ROLE_TEACHER,teacher,lehrer
# TEACHER_GROUPS=lehrer
# HIDDEN_GROUPS=alle,lehrer,schueler,schüler
# LOGIN_LABEL=Mit IServ anmelden
# RETENTION_DAYS=400
# TEMPLATES=true
# GAMIFICATION=true
# TIMEZONE=Europe/Berlin

# Aussprache mit Piper (läuft als Dienst "piper" im Stack, siehe README „Bessere Stimmen“)
# Piper-Stimmen, Komma-getrennt (Standard: Deutsch, Englisch GB/US, Französisch, Spanisch, Italienisch, Niederländisch,
# Russisch, Ukrainisch, Polnisch). Andere Stimmen: https://huggingface.co/rhasspy/piper-voices
# TTS_VOICES=de_DE-thorsten-high,en_GB-alba-medium,fr_FR-siwis-medium,es_ES-davefx-medium
# Ohne Piper leer lassen (und den Dienst "piper" aus dem Stack entfernen):
# TTS_URL=
# So viel MB dürfen fertige Audiodateien belegen
# TTS_CACHE_MB=2000
